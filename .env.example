# ══════════════════════════════════════════════════════════════
# Oracle Backend for Firebase Installer — Configuration
# ══════════════════════════════════════════════════════════════

# ── Database Connection ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE=FREEPDB1
DB_PROTOCOL=tcp

# ── Administrative Credentials (SYS or dedicated installer) ─
ADMIN_USER=SYS
ADMIN_PASSWORD=
ADMIN_ROLE=SYSDBA

# ── DBA User (for OBAAS_ENABLE_SCHEMA — must NOT be SYS) ───
DBA_USER=
DBA_PASSWORD=

# ── Project Schema ──────────────────────────────────────────
SCHEMA_NAME=FUSABASE_USER
SCHEMA_PASSWORD=
SCHEMA_TABLESPACE=FUSABASE_TBS
SCHEMA_TABLESPACE_SIZE=50M
SCHEMA_URL_PATTERN=fusabase_user
ENABLE_DBFS=false

# ── ORDS Configuration ──────────────────────────────────────
ORDS_HOST=http://localhost
ORDS_PORT=8080
ORDS_BASE_PATH=/ords
ORDS_CONFIG_DIR=/opt/ords-config

# ── TDE Configuration (only if TDE is not already configured)
TDE_WALLET_DIR=
TDE_KEYSTORE_PASSWORD=

# ── OAuth Client (for fusabase CLI) ─────────────────────────
OAUTH_CLIENT_NAME=fusabase-cli
OAUTH_CLIENT_DESCRIPTION=OAuth client for the fusabase CLI
OAUTH_SUPPORT_EMAIL=
